{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildScript": "npm run vercel:build",
        "installCommand": "npm install --legacy-peer-deps",
        "outputDirectory": "dist/voxai-chat"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
