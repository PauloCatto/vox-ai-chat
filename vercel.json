{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildScript": "npm run vercel:build"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },

    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "outputDirectory": "dist/voxai-chat"
}